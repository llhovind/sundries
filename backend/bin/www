#!/usr/bin/env node

/**
 * Module dependencies.
 */

var app = require('../app');
var debug = require('debug')('online-store:server');
var http = require('http');

/**
 * Get port from environment and store in Express.
 */

var port = normalizePort(process.env.PORT || '3000');
app.set('port', port);

/**
 * Create HTTP server.
 */

var server = http.createServer(app);

/**
 * Listen on provided port, on all network interfaces.
 */

/**
 * Every permission code referenced by config/routePermissions.js must exist
 * in the permissions table — a typo'd code would deny everyone forever.
 * Async (needs the DB), so it races the listen; failure kills the process.
 */
require('../config/validateRouteGuards').validatePermissionCodes().catch(function (err) {
  console.error('Route permission validation failed:', err.message);
  process.exit(1);
});

server.listen(port);
server.on('error', onError);
server.on('listening', onListening);

/**
 * Background jobs run inside the API process by default (single-box installs).
 * Cloud deployments set JOBS_INLINE=false and run dedicated `npm run worker`
 * instances instead.
 */
if (process.env.JOBS_INLINE !== 'false') {
  require('../services/jobs').start().catch(function (err) {
    console.error('Job runner failed to start (API continues without background jobs):', err.message);
  });
}

/**
 * Normalize a port into a number, string, or false.
 */

function normalizePort(val) {
  var port = parseInt(val, 10);

  if (isNaN(port)) {
    // named pipe
    return val;
  }

  if (port >= 0) {
    // port number
    return port;
  }

  return false;
}

/**
 * Event listener for HTTP server "error" event.
 */

function onError(error) {
  if (error.syscall !== 'listen') {
    throw error;
  }

  var bind = typeof port === 'string'
    ? 'Pipe ' + port
    : 'Port ' + port;

  // handle specific listen errors with friendly messages
  switch (error.code) {
    case 'EACCES':
      console.error(bind + ' requires elevated privileges');
      process.exit(1);
      break;
    case 'EADDRINUSE':
      console.error(bind + ' is already in use');
      process.exit(1);
      break;
    default:
      throw error;
  }
}

/**
 * Event listener for HTTP server "listening" event.
 */

function onListening() {
  var addr = server.address();
  var bind = typeof addr === 'string'
    ? 'pipe ' + addr
    : 'port ' + addr.port;
  debug('Listening on ' + bind);
}
