{
  "name": "online-store",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "start": "node ./bin/www",
    "dev": "nodemon ./bin/www",
    "worker": "node bin/worker.js",
    "migrate": "node db/migrate.js",
    "bootstrap": "node db/bootstrap.js",
    "setup": "node db/migrate.js && node db/bootstrap.js",
    "test": "jest --testTimeout=15000 --forceExit"
  },
  "jest": {
    "setupFiles": [
      "<rootDir>/tests/setupEnv.js"
    ]
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "~1.4.4",
    "debug": "~2.6.9",
    "dotenv": "^17.4.1",
    "express": "^4.18.2",
    "http-errors": "~1.6.3",
    "jsonwebtoken": "^9.0.3",
    "morgan": "~1.9.1",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.5",
    "pg": "^8.11.3",
    "pg-boss": "^10.4.2"
  },
  "devDependencies": {
    "jest": "^30.3.0",
    "nodemon": "^3.0.2",
    "supertest": "^7.2.2"
  }
}
