{
  "name": "sundries-api",
  "version": "0.2.0",
  "private": true,
  "description": "Sundries API — self-hosted ecommerce platform for physical goods. Express + PostgreSQL, plain SQL.",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node ./bin/www",
    "dev": "nodemon ./bin/www",
    "worker": "node bin/worker.js",
    "migrate": "node db/migrate.js",
    "bootstrap": "node db/bootstrap.js",
    "setup": "node db/migrate.js && node db/bootstrap.js",
    "seed:demo": "node db/seedDemo.js",
    "docs:api": "node bin/generateApiDocs.js",
    "test": "jest --testTimeout=15000 --forceExit",
    "test:queue": "node --test \"tests/integration/*.test.mjs\""
  },
  "jest": {
    "setupFiles": [
      "<rootDir>/tests/setupEnv.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/tests/integration/"
    ]
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "~1.4.4",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.5",
    "pg": "^8.23.0",
    "pg-boss": "^12.27.0"
  },
  "devDependencies": {
    "jest": "^30.3.0",
    "nodemon": "^3.0.2",
    "supertest": "^7.2.2"
  }
}
