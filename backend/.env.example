DB_HOST=localhost
DB_PORT=5432
DB_USER=store_web
DB_PASSWORD=your_db_password_here
DB_NAME=store
# 'true' = TLS w/ cert verification (production), 'no-verify' = TLS w/o verification,
# 'false' = plaintext (local dev)
DB_SSL=false
DB_POOL_MAX=10

# Initial admin (used once by `node db/bootstrap.js`; login is by emailed OTP)
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin

# `npm run seed:demo` refuses to write sample products into a production
# database; set this to run it there anyway (demo deployments only).
#ALLOW_DEMO_SEED=true

# Backup defaults (used by db/backup.sh)
BACKUP_DIR=/var/backups/store
BACKUP_RETENTION_DAYS=14

# Payments: 'fake' (local demo — refused in production) or 'stripe'
# For stripe: npm install stripe, then set the two keys below (required at startup)
PAYMENT_PROVIDER=fake
#STRIPE_SECRET_KEY=sk_live_or_test_key
#STRIPE_WEBHOOK_SECRET=whsec_from_stripe_dashboard
# Escape hatch for demoing the fake provider under NODE_ENV=production, which
# otherwise refuses to start. Never set this on a store taking real money.
#ALLOW_FAKE_PAYMENTS=true

# Mail: 'smtp' (default, uses SMTP_* above), 'ses' (npm install @aws-sdk/client-sesv2,
# credentials from the standard AWS chain; optional SES_FROM overrides SMTP_FROM),
# or 'noop' (accepts and discards all mail — tests and mail-less installs;
# test runs default to noop regardless of this setting)
#MAIL_PROVIDER=smtp
#SES_FROM=noreply@example.com

# Search: 'postgres' (default, zero infrastructure) or 'opensearch'
# For opensearch: npm install @opensearch-project/opensearch
#SEARCH_PROVIDER=postgres
#OPENSEARCH_URL=https://search1:9200
#OPENSEARCH_INDEX=products

# Catalog images: 'local' (default — backend/uploads/, served by this API) or 's3'.
# 'local' files are on ONE machine: any deployment with 2+ API instances needs s3.
# For s3: npm install @aws-sdk/client-s3, credentials from the standard AWS chain.
# IMAGE_PUBLIC_BASE_URL is where image keys are served from — final URL is
# "<IMAGE_PUBLIC_BASE_URL>/<product_no>/<filename>". Point it at the CDN in front
# of the bucket, including the S3_PREFIX path segment.
#IMAGE_PROVIDER=local
#S3_BUCKET=my-store-images
#S3_PREFIX=images
#IMAGE_PUBLIC_BASE_URL=https://cdn.example.com/images

# Background jobs: run inside the API process by default.
# Cloud fleets set JOBS_INLINE=false here and run `npm run worker` separately.
#JOBS_INLINE=true

# Queue transport. 'pgboss' (default) uses Postgres as the queue — durable,
# retried, and scheduled. 'inline' runs enqueued work on the caller's stack and
# runs no scheduled work at all: suitable for tests, and for an install that
# knowingly wants neither retries nor cron. Anything else fails at startup.
#QUEUE_PROVIDER=pgboss

JWT_ACCESS_SECRET=generate-a-random-32-plus-char-string
JWT_REFRESH_SECRET=generate-a-different-random-32-plus-char-string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7

# SMTP_* are only required when MAIL_PROVIDER is 'smtp' or unset
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=noreply@example.com

COOKIE_SECURE=false
NODE_ENV=development
PORT=3000

# Express `trust proxy` — how req.ip / req.protocol read X-Forwarded-* headers.
# Unset (default) trusts no proxy; correct for local dev and direct-to-internet.
# Behind a reverse proxy set the number of proxies in front (e.g. 1 for nginx/ALB);
# also accepts a trusted IP/CIDR list or a preset like `loopback`.
# TRUST_PROXY=1
